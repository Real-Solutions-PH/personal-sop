# Vercel builds the Next.js prototype (root directory: frontend/) and the
# marketing site (root directory: marketing/). Upload both plus the root Bun
# workspace files they install from.
/*
!/frontend
!/marketing
!/package.json
!/bun.lock
!/e2e
/e2e/*
!/e2e/package.json
/frontend/node_modules
/frontend/.next
/frontend/.env
/frontend/.env.local
/marketing/node_modules
/marketing/.next
/marketing/out
