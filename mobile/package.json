  },
  "devDependencies": {
    "@babel/core": "^8.0.10",
    "@bacons/apple-targets": "5.0.0",
    "@biomejs/biome": "^2.6.4",
    "@hey-api/openapi-ts": "0.73.0",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "dotenv": "^18.0.9",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
