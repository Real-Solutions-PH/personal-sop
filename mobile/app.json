{
  "expo": {
    "name": "Unfurl",
    "slug": "personal-sop",
    "version": "0.0.0",
    "orientation": "portrait",
    "scheme": "personalsop",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.schadenkai.personal-sop",
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#1f5a43"
      },
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "@sentry/react-native/expo",
      "expo-secure-store",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Unfurl to use the microphone for dictation and voice captures.",
          "speechRecognitionPermission": "Allow Unfurl to turn what you say into text as you speak."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Unfurl to record voice captures.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a profile picture or capture photo.",
          "cameraPermission": "Take a photo for a capture.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Unfurl to use your location to show local weather and the forecast for planning outdoor work.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-font",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#1f5a43",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#121513"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {
        "origin": false,
        "root": "./src/app"
      }
    }
  }
}
