{
  "expo": {
    "name": "Personal SOP",
    "slug": "personal-sop",
    "version": "0.0.0",
    "orientation": "portrait",
    "scheme": "personalsop",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "@sentry/react-native/expo",
      "expo-secure-store",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Personal SOP to record voice captures.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a profile picture or capture photo.",
          "cameraPermission": "Take a photo for a capture.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Personal SOP to use your location to show local weather and the forecast for planning outdoor work.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {
        "origin": false,
        "root": "./src/app"
      }
    }
  }
}
