<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/unfurl_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/unfurl_widget_bg">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
  <TextView android:id="@+id/tasks_caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/unfurl_muted" android:textAllCaps="true" android:letterSpacing="0.08" android:textStyle="bold" android:text="Up next" />
  <TextView android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
  <TextView android:id="@+id/tasks_overdue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/unfurl_warn" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
</LinearLayout>
<TextView android:id="@+id/tasks_empty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/unfurl_muted" android:maxLines="1" android:ellipsize="end" android:text="Nothing due. Enjoy the space." android:visibility="gone" android:layout_marginTop="6dp"/>
<LinearLayout android:id="@+id/task_row_0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
  <TextView android:id="@+id/task_title_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/unfurl_text" android:maxLines="1" android:ellipsize="end" />
  <TextView android:id="@+id/task_when_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/unfurl_muted" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
<LinearLayout android:id="@+id/task_row_1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
  <TextView android:id="@+id/task_title_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/unfurl_text" android:maxLines="1" android:ellipsize="end" />
  <TextView android:id="@+id/task_when_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/unfurl_muted" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
<LinearLayout android:id="@+id/task_row_2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
  <TextView android:id="@+id/task_title_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/unfurl_text" android:maxLines="1" android:ellipsize="end" />
  <TextView android:id="@+id/task_when_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/unfurl_muted" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
<LinearLayout android:id="@+id/task_row_3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
  <TextView android:id="@+id/task_title_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/unfurl_text" android:maxLines="1" android:ellipsize="end" />
  <TextView android:id="@+id/task_when_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/unfurl_muted" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>

</LinearLayout>
