<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/unfurl_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/unfurl_widget_bg">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
  <TextView android:id="@+id/habits_caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/unfurl_muted" android:textAllCaps="true" android:letterSpacing="0.08" android:textStyle="bold" android:text="Habits" />
  <TextView android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
  <TextView android:id="@+id/habits_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/unfurl_hab" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
</LinearLayout>
<TextView android:id="@+id/habits_empty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/unfurl_muted" android:maxLines="1" android:ellipsize="end" android:text="Nothing due today" android:visibility="gone" android:layout_marginTop="6dp"/>
<LinearLayout android:id="@+id/habit_row_0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
  <TextView android:id="@+id/habit_icon_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="@color/unfurl_text" android:maxLines="1" android:ellipsize="end" />
  <TextView android:id="@+id/habit_name_0" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/unfurl_text" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="8dp" android:layout_weight="1" android:layout_width="0dp"/>
  <TextView android:id="@+id/habit_streak_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/unfurl_life" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:layout_marginEnd="8dp"/>
  <ImageView android:id="@+id/habit_check_0" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/unfurl_check_off" android:contentDescription="Check" />
</LinearLayout>
<LinearLayout android:id="@+id/habit_row_1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
  <TextView android:id="@+id/habit_icon_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="@color/unfurl_text" android:maxLines="1" android:ellipsize="end" />
