  <TextView android:id="@+id/habit_streak_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/unfurl_life" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:layout_marginEnd="8dp"/>
  <ImageView android:id="@+id/habit_check_2" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/unfurl_check_off" android:contentDescription="Check" />
</LinearLayout>
<LinearLayout android:id="@+id/habit_row_3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
