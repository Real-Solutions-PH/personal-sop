<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/unfurl_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/unfurl_widget_bg">
<TextView android:id="@+id/money_caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/unfurl_muted" android:textAllCaps="true" android:letterSpacing="0.08" android:textStyle="bold" android:text="Safe to spend" />
<TextView android:id="@+id/money_safe" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="28sp" android:textColor="@color/unfurl_text" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:layout_marginTop="2dp"/>
<TextView android:id="@+id/money_today" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/unfurl_muted" android:maxLines="1" android:ellipsize="end" android:text="today"/>
<TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
<ProgressBar android:id="@+id/money_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="100" android:progressDrawable="@drawable/unfurl_bar_fin" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
  <TextView android:id="@+id/money_left" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/unfurl_text" android:maxLines="1" android:ellipsize="end" android:layout_weight="1" android:layout_width="0dp"/>
  <TextView android:id="@+id/money_days" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/unfurl_muted" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
</LinearLayout>
